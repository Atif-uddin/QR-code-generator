                "print-layout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paperSize\": \"A4\",\n  \"rows\": 8,\n  \"cols\": 3,\n  \"marginTop\": 10,\n  \"marginBottom\": 10,\n  \"marginLeft\": 10,\n  \"marginRight\": 10,\n  \"includeLabel\": true,\n  \"qrCodes\": [\n    {\n      \"imageUrl\": \"https://res.cloudinary.com/...\",\n      \"label\": \"Sticker 1\"\n    }\n  ]\n}"
            }
          },
          "response": []
        }
      ]
    }
  ],
